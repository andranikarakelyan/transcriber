{
  "private": true,
  "name": "transcriber-desktop",
  "description": "Desktop application for local audio transcription using OpenAI's Whisper",
  "version": "1.0.0",
  "author": {
    "name": "Andranik Arakelyan",
    "email": "andranik.arakelyan.work@gmail.com"
  },
  "main": "app/background.js",
  "scripts": {
    "dev": "nextron",
    "build:win64": "nextron build --win --x64",
    "build:mac": "echo '⚠️  WARNING: macOS build is not tested yet!' && nextron build --mac",
    "build:linux": "echo '⚠️  WARNING: Linux build is not tested yet!' && nextron build --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.52",
    "autoprefixer": "^10.4.19",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "next": "^14.2.4",
    "nextron": "^9.5.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.7.3"
  }
}
